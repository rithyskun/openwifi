{
  "name": "openwifi",
  "version": "1.0.0",
  "description": "P2P mesh network over WiFi — cross-platform (macOS, Windows, Linux)",
  "main": "src/index.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "os": [
    "darwin",
    "win32",
    "linux"
  ],
  "scripts": {
    "start": "node src/index.js",
    "test": "node --test",
    "dev": "node --watch src/index.js",
    "setup": "npm install && node -e \"console.log('OpenWiFi ready. Run: npm start')\"",
    "install:all": "node -e \"console.log('Run: npm install && npm start')\""
  },
  "bin": {
    "openwifi": "./src/index.js"
  },
  "dependencies": {
    "@lmstudio/sdk": "^1.5.0",
    "better-sqlite3": "^11.0.0",
    "express": "^4.21.0",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "multicast-dns": "^7.2.5",
    "socket.io": "^4.7.5",
    "uuid": "^10.0.0",
    "zod": "^4.4.3"
  }
}
